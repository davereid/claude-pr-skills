                "[project-root]/.claude/skills/pr-fix/SETUP.md": "skills/pr-fix/SETUP.md",
                "[project-root]/.claude/skills/pr-fix/README.md": "skills/pr-fix/README.md",
                "[project-root]/.claude/skills/pr-triage/SKILL.md": "skills/pr-triage/SKILL.md",
                "[project-root]/.claude/skills/pr-triage/README.md": "skills/pr-triage/README.md",
                "[project-root]/.claude/skills/pr-triage/profile.example.md": "skills/pr-triage/profile.example.md"
            }
        }
    }
}
