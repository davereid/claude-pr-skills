                "[project-root]/.claude/skills/pr-fix/SETUP.md": "skills/pr-fix/SETUP.md",
                "[project-root]/.claude/skills/pr-fix/README.md": "skills/pr-fix/README.md",
                "[project-root]/.claude/skills/project-triage/SKILL.md": "skills/project-triage/SKILL.md",
                "[project-root]/.claude/skills/project-triage/README.md": "skills/project-triage/README.md",
                "[project-root]/.claude/skills/project-triage/profile.example.md": "skills/project-triage/profile.example.md",
                "[project-root]/.claude/skills/project-triage/issues.example.md": "skills/project-triage/issues.example.md",
                "[project-root]/.claude/skills/project-triage/references/github.md": "skills/project-triage/references/github.md",
                "[project-root]/.claude/skills/project-triage/references/gitlab.md": "skills/project-triage/references/gitlab.md",
                "[project-root]/.claude/skills/project-triage/references/drupalorg.md": "skills/project-triage/references/drupalorg.md"
